# Copy this file to ../.env (project root) and fill in your keys

# Bodhan AI — one key per model (create both in your console at https://console.bodhan.ai)
# Starting credit: ₹10 shared across all keys (~4-5 full 5-min videos)
BODHAN_TRANSLATE_KEY=your_bodhan_indic_translate_key_here
BODHAN_SPEAK_KEY=your_bodhan_indic_speak_key_here

# OpenRouter — used ONLY for the edit resolver (maps natural language → segment IDs)
# Get key at: https://openrouter.ai
# $20 credit → ~20,000 edit-resolve calls at current rates
OPENROUTER_API_KEY=your_openrouter_key_here

# fal.ai — cloud GPU lip sync (~15-20s per segment, free tier available)
# Sign up at https://fal.ai → Dashboard → API Keys → copy key here
# Without this key, lip sync is skipped (audio replaced on original video instead)
FAL_KEY=your_fal_api_key_here

# ── GPU machine only ──────────────────────────────────────────────────────────

# HuggingFace token — required for pyannote speaker diarization (multi-speaker).
# 1. Get a token: https://huggingface.co/settings/tokens  (read scope is enough)
# 2. Accept the gated terms ONCE on both model pages, or loading fails with 401:
#      https://huggingface.co/pyannote/speaker-diarization-3.1
#      https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=your_huggingface_token_here

# Whisper model size. Defaults to "large-v3" on CUDA, "tiny" on CPU.
# VRAM at float16: small ~1GB, medium ~2.5GB, large-v3 ~4.7GB.
WHISPER_MODEL=large-v3

# Diarization: pyannote (GPU, needs HF_TOKEN) or ecapa (old clustering).
DIARIZE_BACKEND=pyannote
# Two pyannote speakers this similar that never talk over each other are one
# person split by tone. Lower = merge more; raise if two similar voices merge.
PYANNOTE_MERGE_SIM=0.75

# ── Speakers & voice casting (diarize node) ───────────────────────────────────
# Who is speaking comes from ECAPA speaker embeddings (SpeechBrain, ~80MB,
# downloaded once into cache/_models). Cosine similarity at/above which two
# segments are the same person — measured: different people -0.07..0.34,
# same person 0.45..0.87.
DIARIZE_SAME_SPEAKER_SIM=0.40
# Pitch at/above which a speaker is female. 180 keeps light male voices male.
FEMALE_F0_HZ=180
# Used only when a speaker's pitch is unmeasurable.
UNKNOWN_GENDER_FALLBACK=male

# ── Sentence merging (transcribe node) ────────────────────────────────────────
# Whisper splits mid-sentence; pieces separated by less than this, where the
# first has no closing punctuation, are joined before translation.
MERGE_GAP_SECS=0.6
MAX_SENTENCE_SECS=15
# Fragments shorter than this join their nearest neighbour.
MIN_FRAGMENT_SECS=1.2

# ── Timing / fitting (align node) ─────────────────────────────────────────────
# A dub never runs into the next line. Lines that need more than MAX_STRETCH
# speed-up are rewritten shorter by the LLM and re-voiced (REFIT_ROUNDS times,
# needs OPENROUTER_API_KEY). Only what still overruns is sped up, at most to
# HARD_MAX_STRETCH, before trimming. Each voice's real speaking rate is
# measured every run (cache/_tts_rates.json) and sets the translation budget.
MAX_STRETCH=1.10
HARD_MAX_STRETCH=1.25
REFIT_ROUNDS=2
BUDGET_BORROW_SECS=0.6
MIN_RATE=1.0
GAP_BORROW_MAX_SECS=3.0
# A line too long for its slot borrows silence from its neighbours before it
# is sped up: it may start up to DUB_LEAD_MAX_SECS early and push the next
# line up to DUB_DELAY_MAX_SECS late (if that line has room at its end).
DUB_LEAD_MAX_SECS=0.35
DUB_DELAY_MAX_SECS=0.5

# ── Voice cloning (Seed-VC, local, free) ──────────────────────────────────────
# Each TTS line is re-voiced in the original speaker's timbre, every line of
# a speaker against the same reference. Needs dubbing/SeedVC (setup_gpu.sh).
VOICE_CLONE=1
SEEDVC_STEPS=30
SEEDVC_CFG=0.7

# ── Laughter / non-verbal sounds ──────────────────────────────────────────────
# Laughs, chuckles, a throat clear where nobody is speaking keep the original
# sound under the dub (AudioSet AST classifier on the vocal track).
NONVERBAL=1
NONVERBAL_THRESHOLD=0.1
# Rough pre-synthesis guess, only to catch egregious overruns early.
TTS_CHARS_PER_SEC=14
OVERRUN_TRIGGER=1.15

# ── YouTube download ──────────────────────────────────────────────────────────
# If YouTube says "Sign in to confirm you're not a bot", use your login cookies:
#   YTDLP_COOKIES_BROWSER=firefox   (or edge / chrome — browser must be CLOSED)
#   YTDLP_COOKIES_FILE=C:/path/to/cookies.txt   (exported, Netscape format)
YTDLP_COOKIES_BROWSER=
YTDLP_COOKIES_FILE=

# ── Transcription text ────────────────────────────────────────────────────────
# Whisper gives timing; each line's TEXT is then re-transcribed by Bodhan
# indic-transcribe (more accurate), with Whisper's text kept as a second
# opinion for the translator. ASR_TEXT=whisper to skip Bodhan.
BODHAN_TRANSCRIBE_KEY=your_bodhan_indic_transcribe_key_here
ASR_TEXT=bodhan
# Source-language hint for Bodhan (en, hi, ta, ...). Blank = Whisper's guess.
SOURCE_LANG=
# Parallel requests; Bodhan returns 429 above ~3.
BODHAN_ASR_WORKERS=3

# ── Translation (translate node) ──────────────────────────────────────────────
# llm    = translate the whole dialogue in one context-aware call via
#          OpenRouter: knows each speaker's gender, keeps one register, infers
#          what mis-heard ASR words meant, respects each line's time budget.
#          ~$0.03-0.05 per 2-minute video with the default model.
# bodhan = Bodhan indic-translate, one line at a time, no context (old way).
TRANSLATOR=llm
# Any OpenRouter model id. Cheaper alternative: google/gemini-3.8-flash
TRANSLATE_MODEL=anthropic/claude-sonnet-5.5
# spoken (natural conversational dub) | neutral | formal (news/official)
TRANSLATE_REGISTER=spoken

# ── Separation (separate node) ────────────────────────────────────────────────
# Demucs splits the voice from the background (music, applause, room tone).
# The background then replaces the original under the dub, removing the
# original voice outright. ~0.8x real time on CPU, a few seconds on GPU.
# SEPARATE=none skips it (falls back to ducking with DUCK_DB below).
SEPARATE=demucs
DEMUCS_MODEL=htdemucs

# ── Delivery matching ─────────────────────────────────────────────────────────
# With the style dropdown on "Auto", each line's measured delivery picks a
# Bodhan style: energetic→happy, urgent→TV news, announcing→AIR news,
# calm/whispered→audiobook narration. Neutral lines use this base style.
AUTO_BASE_STYLE=educational lecture

# ── Mixing ────────────────────────────────────────────────────────────────────
# Crossfade between original audio and background bed at dialogue edges.
BED_FADE_SECS=0.01
# How far to duck the original voice. -18 dB leaves it clearly audible under
# the dub; -45 removes it. Use -100 for literal silence, or -25 to keep a
# trace of the original performance.
DUCK_DB=-45
# Padding either side of each dubbed span. Whisper's VAD clips the attack and
# tail of speech, so ducking exactly [start, end] leaves audible fragments.
DUCK_PAD=0.25
# Gaps between dubbed spans shorter than this get ducked as well — a
# sub-second gap mid-sentence is trimmed speech, not ambience worth keeping.
# Raise it to remove more of the original; lower it to keep more ambience.
DUCK_BRIDGE_GAP=1.2
# Broadcast loudness normalization of the final mix.
LOUDNORM=1
LUFS_TARGET=-14
TRUE_PEAK=-1.0

# ── Lip sync ──────────────────────────────────────────────────────────────────
# latentsync (default when dubbing/LatentSync/.venv-ls exists) | wav2lip | fal | none
LIPSYNC_BACKEND=
# Diffusion steps: 20 = best quality; 10-15 is faster with little loss.
LATENTSYNC_STEPS=20

# Model used to turn an edit request into segment ids.
EDIT_MODEL=google/gemini-3.8-flash

# ── Backend toggles (all default off → CPU-safe) ──────────────────────────────
# Local Wav2Lip lip sync. Superseded by LatentSync; kept as a fallback.
WAV2LIP_USE_LOCAL=0
# Enable fal.ai cloud lip sync (needs FAL_KEY + active billing).
FAL_ENABLED=0
