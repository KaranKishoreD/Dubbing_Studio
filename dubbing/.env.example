# Dubbing Studio settings.
#
# Copy this file to the PROJECT ROOT as ".env" (one folder above dubbing/):
#     cp dubbing/.env.example .env
# then paste your keys below. Never commit .env; it is in .gitignore.

# ── Required keys ─────────────────────────────────────────────────────────────
# Bodhan AI (https://console.bodhan.ai): create one key per model.
BODHAN_TRANSLATE_KEY=your-bodhan-indic-translate-key
BODHAN_SPEAK_KEY=your-bodhan-indic-speak-key
# OpenRouter (https://openrouter.ai/keys): transcript clean-up, the dubbing
# director, length fitting and the Revise tab. Typically cents per video.
OPENROUTER_API_KEY=your-openrouter-key

# ── Recommended keys ──────────────────────────────────────────────────────────
# Bodhan indic-transcribe: better transcripts for Indic-language videos.
BODHAN_TRANSCRIBE_KEY=
# Hugging Face read token (https://huggingface.co/settings/tokens) for pyannote
# speaker detection. Also accept the model terms once at
#   https://huggingface.co/pyannote/speaker-diarization-community-1
# Without it a simpler built-in speaker clustering is used.
HF_TOKEN=

# ── Optional keys ─────────────────────────────────────────────────────────────
# Sarvam AI (https://dashboard.sarvam.ai): enables the Sarvam Bulbul voices.
SARVAM_API_KEY=

# ── Web studio ────────────────────────────────────────────────────────────────
# Ask for a password (user name "studio") — set this before sharing a link.
# STUDIO_PASSWORD=

# ── Optional settings ─────────────────────────────────────────────────────────
# Everything below is commented out and shows the built-in default.
# Uncomment a line only to change it.

# Models
# TRANSLATE_MODEL=anthropic/claude-sonnet-5.5   # any OpenRouter model id
# EDIT_MODEL=anthropic/claude-sonnet-5.5        # model behind the Revise tab
# WHISPER_MODEL=large-v3                        # "tiny" on CPU

# Features (1 = on, 0 = off)
# VOICE_CLONE=1        # re-voice lines in the original speaker's voice (Seed-VC)
# FACE_SPEAKERS=1      # use faces to separate characters with similar voices
# SONG_MODE=1          # allow the "re-sing songs" option in the studio
# LOUDNORM=1           # normalise loudness to -14 LUFS

# Lip sync: picked automatically (LatentSync if installed, else none).
# LIPSYNC_BACKEND=latentsync     # latentsync | wav2lip | fal | none
# LATENTSYNC_STEPS=20            # more steps = slightly sharper, slower
# LATENTSYNC_MAX_WORKERS=4       # parallel workers, ~8.5 GB GPU memory each

# Timing
# MAX_STRETCH=1.10       # speed-up the ear does not notice
# HARD_MAX_STRETCH=1.25  # lines needing more are still sped up, and logged
# MIN_RATE=0.90          # slowest a short line is played
# OVERRUN_TRIGGER=1.15   # rewrite a translation shorter above this overrun
# GAP_BORROW_MAX_SECS=1.0

# Speakers
# NUM_SPEAKERS=          # force a speaker count (the studio has a dropdown)
# DIARIZE_BACKEND=pyannote   # pyannote | ecapa

# Download
# MAX_VIDEO_HEIGHT=720
# If YouTube says "Sign in to confirm you're not a bot", use your browser's
# login cookies or an exported cookies.txt:
# YTDLP_COOKIES_BROWSER=firefox
# YTDLP_COOKIES_FILE=/path/to/cookies.txt
